@model Emp
<!DOCTYPE html>
<html>
<head>
    <title></title>
</head>
<body>
    <h2> Edit Emp </h2>
    <form asp-action="Edit" method="Post">
        <input type="hidden" asp-for="EmpID" />
        <div>
            <label asp-for="EmpName"></label>
            <div>
                <input asp-for="EmpName" />
            </div>
        </div>
        <div>
            <label asp-for="Address"></label>
            <div>
                <input asp-for="Address" />
            </div>
        </div>
        <div>
            <label asp-for="EmailID"></label>
            <div>
                <input asp-for="EmailID" />
            </div>
        </div>
        <div>
            <label asp-for="MobileNo"></label>
            <div>
                <input asp-for="MobileNo" />
            </div>
        </div>
        <div>
            <label asp-for="Salary"></label>
            <div>
                <input asp-for="Salary" />
            </div>
        </div>
        <div>
            <label>Select Dept</label>
            <div>
                <select asp-for="DeptID" asp-items="@ViewBag.Depts">
                    <option>Select Dept</option>
                </select>
            </div>
        </div>
        <input type="submit" value="Update" />
    </form>
</body>
</html>